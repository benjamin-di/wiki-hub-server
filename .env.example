# Copy/generate .env with examples/initialize.py; keep .env private.
# Replace the three example hostnames and the owner username before starting.
WIKI_PUBLIC_URL=https://wiki.example.com
OIDC_ISSUER=https://id.example.com
FORGEJO_PUBLIC_URL=https://git.example.com
WIKI_OWNER_USERNAME=
WIKI_OWNER_EMAIL=
WIKI_OWNER_SUBJECT=
SETUP_UID=
SETUP_GID=
FORGEJO_USERNAME=wiki-hub-system
FORGEJO_PASSWORD=
POCKET_ID_ENCRYPTION_KEY=
POCKET_ID_STATIC_API_KEY=
WIKI_WEB_CLIENT_SECRET=
WIKI_WEB_SESSION_KEY=
# Optional runtime directory key: users:read and oidc-clients:read only.
# Never put the bootstrap/static administrator key here.
WIKI_DIRECTORY_API_KEY=
# Bring a compatible model endpoint; no model or API account is created.
WIKI_MODEL_URL=https://api.openai.com/v1/chat/completions
WIKI_MODEL_NAME=
WIKI_MODEL_API_KEY=
WIKI_MODEL_RESPONSE_FORMAT=json_schema
WIKI_MODEL_TOKEN_PARAMETER=max_completion_tokens
WIKI_MODEL_OUTPUT_TOKENS=8192
